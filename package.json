{
  "name": "keel-craft",
  "version": "0.4.2",
  "description": "Backend craft skill for AI coding agents — scored critique, personas, detector, hooks, doctor, live API",
  "type": "module",
  "bin": {
    "keel": "cli/bin/keel.js"
  },
  "files": [
    "cli/",
    "skill/",
    "scripts/",
    "install.sh",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/raulaguila/keel.git"
  },

  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "keel",
    "backend",
    "skills",
    "cursor",
    "architecture",
    "lint",
    "critique"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "detect": "node skill/scripts/detect.js",
    "status": "node skill/scripts/status.js",
    "doctor": "node skill/scripts/doctor.js",
    "live": "node skill/scripts/live-api.js",
    "pin": "node skill/scripts/pin.js",
    "sync": "node scripts/sync-providers.js",
    "test:detector": "node tests/oracle/run-detector.mjs",
    "test:smoke": "node tests/smoke/run.mjs",
    "test": "npm run test:detector && npm run test:smoke",
    "install:skill": "node cli/bin/keel.js install --providers=cursor"
  }
}
